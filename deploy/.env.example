# For a company installation run `uv run erag init` (or deploy/install.sh) instead of copying this file: it writes
# deploy/.env with strong random secrets, the production settings, a master key and a one-time setup token.
# For development, copy this file to deploy/.env (Docker Compose) or to the repo root as `.env` (never commit it).
# All app settings use the ERAG_ prefix; see backend/app/core/config.py for the full list.

ERAG_ENV=dev
# Generate strong values for anything beyond a local demo, e.g. `openssl rand -hex 32`.
ERAG_SECRET_KEY=dev-insecure-secret-change-me
ERAG_MCP_CONTEXT_SECRET=dev-insecure-mcp-secret-change-me

# Credential store master key (32 random bytes, base64): `uv run erag secrets init` (erag init does it). Use ONE of:
# ERAG_SECRETS_KEY=...
# ERAG_SECRETS_KEY_FILE=/data/secrets.key   (default in docker-compose; generated on first start in dev)

# Setup (ADR 0034). A fresh database starts in setup mode: open the web interface and enter the setup token, printed
# by `erag init` (only its SHA-256 is kept here) or, without it, generated at first start and written to the app log
# and to /data/setup-token. `erag setup --new-token` / `--reset` on the server issue a new one.
# ERAG_SETUP_TOKEN_SHA256=
# ERAG_SETUP_TOKEN_TTL_HOURS=24
# ACME Corp demo: choose "Demo with mock data" in the wizard. ERAG_SEED_DEMO=true seeds the full demo (including
# admin@acme.test, password ERAG_DEMO_PASSWORD) at start-up instead, for development and scripts/demo_scenarios.py;
# it counts as a completed setup and is ignored in production (ADR 0040).
ERAG_SEED_DEMO=false
# ERAG_DEMO_PASSWORD=acme-demo-password

POSTGRES_USER=erag
POSTGRES_PASSWORD=erag
POSTGRES_DB=erag
POSTGRES_HOST_PORT=55432
APP_PORT=8000

# Ollama. With docker-compose.hostnet.yml the app uses http://127.0.0.1:11434 automatically.
ERAG_OLLAMA_BASE_URL=http://host.docker.internal:11434
ERAG_LOCAL_CHAT_MODEL=qwen3:4b-instruct-2507-q4_K_M

# OpenRouter (optional). Preferred: set the key in Admin > Providers (stored encrypted in the
# credential store). This variable is only a bootstrap fallback, used when the store has no key.
ERAG_OPENROUTER_API_KEY=
# The default model is a free one so the demo costs nothing; paid models may be added in Admin > Providers.
ERAG_OPENROUTER_MODEL=meta-llama/llama-3.3-8b-instruct:free
# Initial monthly ceiling in USD for OpenRouter (the worst case of every request is checked before sending).
# Also set a credit limit on the OpenRouter key itself: it is the bound that holds even if the app is misused.
ERAG_OPENROUTER_MONTHLY_BUDGET_USD=0.01

# Metered providers (ADR 0024, 0026): initial defaults for the monthly ceiling in USD, the daily request cap and
# the maximum output tokens per request (sent as max_tokens). Admins may lower or raise them per provider in
# Admin > Providers (step-up, audited, shown in the change history).
ERAG_PROVIDER_MONTHLY_BUDGET_USD=0.01
ERAG_PROVIDER_DAILY_REQUEST_CAP=100
ERAG_PROVIDER_MAX_OUTPUT_TOKENS=2048
# Highest classification any cloud model may receive (public or internal; confidential is never allowed). This is
# the initial default: the setup wizard (Organization) stores the administrator's choice in the database.
ERAG_CLOUD_MAX_CLASSIFICATION=internal

# Set to true behind HTTPS.
ERAG_COOKIE_SECURE=false

# Connectors (folder roots, mounted read-only) and outbound allowlist for non-public destinations.
# ERAG_CONNECTOR_ROOTS=/connectors
# ERAG_SSRF_ALLOWLIST=mcp-office:8791

# Isolated MCP runner. Approved images pinned by ID:
#   docker build -f deploy/mcp-office.Dockerfile -t erag-mcp-office:0.2 .
#   ERAG_RUNNER_IMAGES=office=$(docker image inspect erag-mcp-office:0.2 --format '{{.Id}}')
# ERAG_RUNNER_IMAGES=
# Use a long random value outside local demos (`openssl rand -hex 32`).
# ERAG_RUNNER_TOKEN=dev-insecure-runner-token
