# Copy to the repo root as `.env` (never commit `.env`).
# All app settings use the ERAG_ prefix; see backend/app/core/config.py for the full list.

ERAG_ENV=dev
# Generate strong values for anything beyond a local demo, e.g. `openssl rand -hex 32`.
ERAG_SECRET_KEY=dev-insecure-secret-change-me
ERAG_MCP_CONTEXT_SECRET=dev-insecure-mcp-secret-change-me

# Credential store master key (32 random bytes, base64): `uv run erag secrets init`. Use ONE of:
# ERAG_SECRETS_KEY=...
# ERAG_SECRETS_KEY_FILE=/data/secrets.key   (default in docker-compose; generated on first start in dev)

POSTGRES_USER=erag
POSTGRES_PASSWORD=erag
POSTGRES_DB=erag
POSTGRES_HOST_PORT=55432
APP_PORT=8000

# Ollama. With docker-compose.hostnet.yml the app uses http://127.0.0.1:11434 automatically.
ERAG_OLLAMA_BASE_URL=http://host.docker.internal:11434
ERAG_LOCAL_CHAT_MODEL=qwen3:4b-instruct-2507-q4_K_M

# OpenRouter (optional). Preferred: set the key in Admin > Providers (stored encrypted in the
# credential store). This variable is only a bootstrap fallback, used when the store has no key.
ERAG_OPENROUTER_API_KEY=
ERAG_OPENROUTER_MODEL=meta-llama/llama-3.3-8b-instruct:free
# Only ":free" models are accepted unless this is true. Hard monthly ceiling in USD (checked before each request).
ERAG_OPENROUTER_ALLOW_PAID=false
ERAG_OPENROUTER_MONTHLY_BUDGET_USD=0.01

# Providers added in Admin > Providers (ADR 0023/0024): per-provider monthly ceiling in USD (applied when the
# provider reports cost) and daily request cap. The admin panel can only lower them.
ERAG_PROVIDER_MONTHLY_BUDGET_USD=0.01
ERAG_PROVIDER_DAILY_REQUEST_CAP=100
# Highest classification any cloud model may receive (public or internal; confidential is never allowed).
ERAG_CLOUD_MAX_CLASSIFICATION=internal

# Set to true behind HTTPS.
ERAG_COOKIE_SECURE=false

# Connectors (folder roots, mounted read-only) and outbound allowlist for non-public destinations.
# ERAG_CONNECTOR_ROOTS=/connectors
# ERAG_SSRF_ALLOWLIST=mcp-office:8791

# Isolated MCP runner. Approved images pinned by ID:
#   docker build -f deploy/mcp-office.Dockerfile -t erag-mcp-office:0.2 .
#   ERAG_RUNNER_IMAGES=office=$(docker image inspect erag-mcp-office:0.2 --format '{{.Id}}')
# ERAG_RUNNER_IMAGES=
# Use a long random value outside local demos (`openssl rand -hex 32`).
# ERAG_RUNNER_TOKEN=dev-insecure-runner-token
